# Copy to .env (or a systemd EnvironmentFile) and fill in. Never commit real values.

# Where the app is mounted and the public URL people use (links in emails point here)
TS_BASE_PATH=/tunesummary
TS_PUBLIC_URL=http://127.0.0.1:8797/tunesummary
TS_HOST=127.0.0.1
TS_PORT=8797
TS_DATA_DIR=./data
# Browser origins allowed to POST (comma-separated)
TS_ALLOWED_ORIGINS=http://127.0.0.1:8797

# Email: "smtp" sends for real, "log" writes messages to <data>/outbox.log (default when no SMTP host is set)
TS_MAIL_BACKEND=log
TS_SMTP_HOST=smtp.gmail.com
TS_SMTP_PORT=587
TS_SMTP_USER=
TS_SMTP_PASS=
TS_MAIL_FROM=
TS_MAIL_FROM_NAME=TuneSummary
TS_MAIL_DAILY_CAP=400

# Optional: "Continue with Google" (hidden until both are set).
# Redirect URI to register: <TS_PUBLIC_URL>/auth/google/callback
TS_GOOGLE_CLIENT_ID=
TS_GOOGLE_CLIENT_SECRET=

# Optional: one AdSense slot (off when empty). Supporters never see it.
TS_ADSENSE_CLIENT=
TS_ADSENSE_SLOT=

# Recap story gate: off (everyone gets it all) | ad (rewarded ad unlocks it per sign-in) | supporter (plan only)
TS_RECAP_GATE=off
TS_RECAP_AD_SECONDS=15

# Live updates via Last.fm (optional; all Last.fm UI is hidden while the key is empty).
# Key: https://www.last.fm/api/account/create. With the shared secret set, users link through Last.fm's own sign-in
# (callback <TS_PUBLIC_URL>/auth/lastfm/callback, ownership verified); without it they type a public username.
TS_LASTFM_API_KEY=
TS_LASTFM_SHARED_SECRET=
# Who can refresh: off (button + daily background sync for everyone) | ad (rewarded ad per refresh, one per
# TS_LIVE_AD_HOURS; supporters sync automatically) | supporter (supporters only). First sync after linking is always free.
TS_LIVE_GATE=off
TS_LIVE_AD_SECONDS=15
TS_LIVE_AD_HOURS=3
TS_LIVE_AUTO_HOURS=24
TS_LIVE_SUPPORTER_HOURS=4
TS_LIVE_MANUAL_MINUTES=15

# Testing knobs: length of one reminder "day" in seconds, scheduler interval, background workers on/off
TS_REMIND_UNIT_SECONDS=86400
TS_SCHEDULER_SECONDS=60
TS_WORKERS=1
